# ==============================================================================
# Legal AI Assistant Ecosystem - Backend Environment Configuration
# ==============================================================================

# Application Environment Mode
# Options: development, staging, production
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# JSON Web Token Secret for secure authentication & session derivation
# In production, set a strong random 256-bit string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Supabase Database Credentials (PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# CORS Allowed Origins (Comma-separated)
# In production: provide your exact deployed frontend domains
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging & Observability
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
JSON_LOGS=true
