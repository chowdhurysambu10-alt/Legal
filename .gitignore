# ==============================================================================
# Git Ignore for Legal AI Project
# ==============================================================================

# Environment variables & API keys (CRITICAL - never commit secrets!)
.env
.env.*
!.env.example
*.env

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs & caches
dist/
dist-ssr/
build/
.vite/
*.local

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Local databases & sessions
*.db
*.sqlite
*.sqlite3
*.ses
:memory:.ses
legal_local.db

# ChromaDB vector index storage
chroma_db/
chroma/
*.chroma

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor & IDE configs
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Nested accidental clones
Legal/
